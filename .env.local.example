
# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── App URL (share links, emails) ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ── Admin (comma-separated emails) ────────────────────────────────────────────
ADMIN_EMAILS=admin@yourdomain.com

# ── Internal API (welcome email from signIn; use same as CRON_SECRET if preferred)
INTERNAL_API_SECRET=your-random-internal-secret
CRON_SECRET=your-random-secret-string

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Groq LLM (Optional) ───────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Tavily (Optional — Indian product web search fallback) ───────────────────
TAVILY_API_KEY=your-tavily-api-key

# ── Scraper Service (Scrapling-powered, optional) ───────────────────────────
SCRAPER_URL=http://localhost:8100

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── Error monitoring (Optional) ───────────────────────────────────────────────
SENTRY_DSN=

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Amazon Associates (India) ────────────────────────────────────────────────
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=BioYou-21

# ── Unsubscribe Token Signing (optional, falls back to NEXTAUTH_SECRET) ───────
UNSUBSCRIBE_SECRET=generate-with-openssl-rand-base64-32
